{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "One pod per WireGuard key"
    },
    "images": {
      "type": "object",
      "properties": {
        "wireguard": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false
        },
        "transmission": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "webPort": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        },
        "peerPortTcp": {
          "description": "Removed in 1.0: peers connect through the VPN to transmission.settings.peer-port"
        },
        "peerPortUdp": {
          "description": "Removed in 1.0: peers connect through the VPN to transmission.settings.peer-port"
        },
        "exposePeerPorts": {
          "description": "Removed in 1.0: peers only connect through the VPN"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "issuer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "privateKeySecretName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        },
        "hostPath": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "mounts": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "mountPath": {
                  "type": "string"
                },
                "subPath": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transmission": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object"
        },
        "settings": {
          "type": "object",
          "properties": {
            "peer-port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "securityContext": {
          "type": "object"
        },
        "bindToTunnel": {
          "const": true,
          "description": "Must stay true: peer sockets are always bound to the tunnel address"
        },
        "rpcAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "allowAnonymous": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "wireguard": {
      "type": "object",
      "properties": {
        "wg0Conf": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "env": {
          "type": "object"
        },
        "kernelMode": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mountLibModules": {
              "type": "boolean"
            },
            "mountTun": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "dns": {
          "type": "object",
          "properties": {
            "override": {
              "type": "boolean"
            },
            "nameservers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}$"
              },
              "maxItems": 3
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ip"
            ],
            "properties": {
              "ip": {
                "type": "string",
                "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "handshakeMaxAgeSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webAllowedCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$|^([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
          }
        },
        "wgFwmark": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "maximum": 4294967295,
          "pattern": "^(0[xX][0-9a-fA-F]{1,8}|[1-9][0-9]{0,9})$"
        },
        "allowConfHooks": {
          "type": "boolean"
        },
        "allowConfFirewallHooks": {
          "description": "Removed: renamed to allowConfHooks"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ipEchoUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "vpnEgressIPs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}$"
          },
          "description": "Your VPN's exit addresses; when set, helm test requires the pod's egress to be one of them"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "failureThreshold": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "global": {
      "type": "object",
      "description": "Set by parent charts; unused"
    }
  }
}
