{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "14 days",
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Each kindest/node digest belongs to one kind release, and every leg's Kubernetes version is chosen (1.29 is the oldest the chart supports): node images, kind and kubectl are bumped together by hand",
      "matchPackageNames": ["kindest/node"],
      "enabled": false
    },
    {
      "description": "linuxserver tags are <version>-r<build>-ls<revision>; docker versioning would treat a new -rN-lsNNN suffix as incompatible and never offer an update",
      "matchPackageNames": ["lscr.io/linuxserver/transmission", "ghcr.io/linuxserver/wireguard"],
      "matchDepTypes": ["image"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Chart.yaml's appVersion follows the Transmission image (tests/metadata-test.sh checks it), so they update together",
      "matchPackageNames": ["lscr.io/linuxserver/transmission"],
      "groupName": "Transmission"
    },
    {
      "description": "The chart's own images: tags are <tool version>-<build date and time>, and its weekly rebuild (Alpine's fixes) comes from this repository's CI, so it need not wait 14 days. Also referenced from Chart.yaml; one PR for both",
      "matchPackageNames": ["ghcr.io/czprz/twg-wireguard", "ghcr.io/czprz/twg-transmission"],
      "matchDepTypes": ["image"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d{8}(\\d{4})?)$",
      "minimumReleaseAge": "0 days",
      "groupName": "WireGuard"
    },
    {
      "description": "Helm 3.14 is the oldest version the chart supports: its CI legs stay on it",
      "matchDepNames": ["helm/helm"],
      "matchCurrentVersion": "v3.14.4",
      "enabled": false
    },
    {
      "description": "The Helm 3 and Helm 4 legs each stay on their major version",
      "matchDepNames": ["helm/helm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "binfmt tags are qemu-vX.Y.Z",
      "matchPackageNames": ["docker.io/tonistiigi/binfmt"],
      "versioning": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default image tag and digest in templates/_helpers.tpl",
      "managerFilePatterns": ["/^templates/_helpers\\.tpl$/"],
      "matchStrings": [
        "\\$tag := default \"(?<currentValue>[^\"]+)\" \\.Values\\.images\\.transmission\\.tag -}}\\n\\{\\{- \\$digest := default \"(?<currentDigest>sha256:[a-f0-9]+)\" \\.Values\\.images\\.transmission\\.digest"
      ],
      "depNameTemplate": "lscr.io/linuxserver/transmission",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^templates/_helpers\\.tpl$/"],
      "matchStrings": [
        "\\$tag := default \"(?<currentValue>[^\"]+)\" \\.Values\\.images\\.wireguard\\.tag -}}\\n\\{\\{- \\$digest := default \"(?<currentDigest>sha256:[a-f0-9]+)\" \\.Values\\.images\\.wireguard\\.digest"
      ],
      "depNameTemplate": "ghcr.io/czprz/twg-wireguard",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "description": "The minimal Transmission image's default (images.transmission.flavor: minimal)",
      "managerFilePatterns": ["/^templates/_helpers\\.tpl$/"],
      "matchStrings": [
        "\"repo\" \"ghcr\\.io/czprz/twg-transmission\" \"tag\" \"(?<currentValue>[^\"]+)\" \"digest\" \"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "depNameTemplate": "ghcr.io/czprz/twg-transmission",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^templates/_helpers\\.tpl$/"],
      "matchStrings": [
        "\\$tag := default \"(?<currentValue>[^\"]+)\" \\.Values\\.tests\\.image\\.tag -}}\\n\\{\\{- \\$digest := default \"(?<currentDigest>sha256:[a-f0-9]+)\" \\.Values\\.tests\\.image\\.digest"
      ],
      "depNameTemplate": "docker.io/alpine/kubectl",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "description": "Images pinned as name:tag@digest in the test scripts, Makefile and workflows",
      "managerFilePatterns": ["/^tests/.+\\.(sh|bash)$/", "/^Makefile$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>(?:[a-z0-9.-]+/)*[a-z0-9._-]+):(?<currentValue>v?[0-9][^\\s@\"']*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "description": "artifacthub.io/images in Chart.yaml",
      "managerFilePatterns": ["/^Chart\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    },
    {
      "customType": "regex",
      "description": "appVersion is the plain Transmission version (the image's x.y.z tag)",
      "managerFilePatterns": ["/^Chart\\.yaml$/"],
      "matchStrings": ["appVersion: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "lscr.io/linuxserver/transmission",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "depTypeTemplate": "appVersion"
    },
    {
      "customType": "regex",
      "description": "A '# renovate: datasource=... depName=...' comment above a line: that line's first version (devcontainer tools, Calico, Cilium, Gateway API)",
      "managerFilePatterns": ["/^\\.devcontainer/post-create\\.sh$/", "/^tests/e2e/kind-cluster\\.sh$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Helm in the CI legs' matrices",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["\\n\\s+helm: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The Go that builds kind in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["go-version: \"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "The QEMU (binfmt) image in the image workflows' signing jobs",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>docker\\.io/tonistiigi/binfmt):(?<currentValue>qemu-v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    }
  ]
}
